{
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check": "bun run lint && (cd apps/api && uv run ruff check && uv run ruff format --check && uv run pytest) && (cd apps/web && bun install --frozen-lockfile && bun run test && bun run build)",
    "lint": "EC_VERSION=v4.0.2 editorconfig-checker && EC_VERSION=v4.0.2 editorconfig-checker -config .editorconfig-checker.exceptions.json -disable-trim-trailing-whitespace apps/api/data/sdoc-hackathon-bundle/attachments/email_519_SI.txt apps/api/data/sdoc-hackathon-bundle/attachments/email_520_SI.txt && prettier --check .",
    "lint:fix": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "editorconfig-checker": "^7.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  }
}
